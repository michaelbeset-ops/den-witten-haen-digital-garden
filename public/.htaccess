# SPA routing: serve index.html for any path that isn't a real file/directory
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Allow direct access to existing files/directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteRule ^ index.html [L]
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Beveiligingsheaders
#
# Let op: deze regels doen alleen iets op Apache-hosting (zoals Vimexx). Op
# GitHub Pages, waar de site nu draait, kunnen geen HTTP-headers worden gezet;
# daar doet de Content-Security-Policy in de meta-tag van index.html het werk.
# X-Frame-Options kan niet in een meta-tag, dus clickjacking-bescherming komt
# er pas bij een verhuizing naar deze hosting bij.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"

  # HSTS staat bewust uit. Zet dit pas aan als https op de nieuwe hosting
  # aantoonbaar werkt, inclusief www: daarna weigeren browsers een jaar lang
  # elke verbinding zonder certificaat.
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>
